{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/", "http://localhost/landing/", "http://localhost/deck/"],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^https?://[^/]+/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.75, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": "^https?://[^/]+/(landing|deck)/",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
