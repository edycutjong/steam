{
  "name": "steam",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "static-panes": "node scripts/render-static-panes.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "bench": "npm run build && node scripts/measure-steam.ts",
    "ingest:gate": "tsx tools/steam-ingest/cli.ts gate quinces-marmalade",
    "props": "tsx tools/steam-ingest/cli.ts gate --all --verify",
    "catalog": "tsx tools/steam-ingest/cli.ts catalog",
    "steam-ingest": "tsx tools/steam-ingest/cli.ts",
    "measure:ingest": "tsx scripts/measure-ingest.ts"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "jpeg-js": "^0.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.11.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.90.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
